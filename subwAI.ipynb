    "\ttest_group.new_routes(stops, id=True)\n",
    "\twith open('test_battery/test_scores.csv', 'w') as f:\n",
    "\t\tprint(\"route,start,end,lines,score\", file=f)\n",
    "\t\tfor idx in range(len(stops)):\n",
    "\t\t\ttry:\n",
    "\t\t\t\ttime, rte, lines = test_group.transfer_path(f\"route{idx+1}\")\n",
    "\t\t\texcept:\n",
    "\t\t\t\troute_id = test_group.routes[f\"route{idx+1}\"]['start']+\",\" + test_group.routes[f\"route{idx+1}\"]['end']\n",
    "\t\t\t\tprint(f\"route{idx+1}\",route_id,\"broken,\", file=f, sep=\",\")\n",
    "\t\t\t\tcontinue\n",
    "\t\t\tstops = [k[0] for k in rte]\n",
    "\t\t\tstops.append(rte[-1][1])\n",
    "\t\t\troute_map =[val for pair in zip(stops, lines) for val in pair]\n",
    "\t\t\tline_length = [(k, len(list(g))) for k,g in groupby(lines)]\n",
    "\t\t\tscore = sum([x[1]**2/len(stops)**2 for x in line_length]) * len(stops)/len(line_length)\n",
    "\t\t\tleast_transfer = [(k,v) for k,v in pd.Series(lines).value_counts(sort=False).to_dict().items()]\n",
    "\t\t\tmid_transfers = [x[1] for x in least_transfer][1:-1]\n",
